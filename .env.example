# =============================================================================
# LOCAL DEVELOPMENT - Copy to .env.local and fill in your DEV Supabase credentials.
# .env.local is gitignored. Use dev project so local testing doesn't touch production.
# =============================================================================

VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_dev_anon_key

# -----------------------------------------------------------------------------
# Server-side keys (Supabase Edge Functions). NOT read by the app.
# Never give these a VITE_ prefix: Vite puts every VITE_ variable in the browser
# bundle. The running functions read them from Supabase function secrets, set
# once per project (dev and prod) - see "Edge Functions" in
# docs/DEV_VS_PROD_DATABASE.md. Keeping a copy here in .env.local is only for
# setting that secret and for `node scripts/spelling-eval/run.mjs` and
# `node scripts/chat-routing-eval/run.mjs`. The spelling-matches and family-chat
# functions both read TYPESAFE_API_KEY.
# -----------------------------------------------------------------------------
# TYPESAFE_API_KEY=your_typesafe_key

# The family-chat function's OpenRouter key (LIN-71). Make it in OpenRouter with
# a credit cap. Set it as a function secret on dev and on prod; it is never
# needed by the app itself.
# OPENROUTER_API_KEY=your_openrouter_key
